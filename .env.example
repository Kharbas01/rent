# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=RentFlow
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Set to true only when serving the app over HTTPS
COOKIE_SECURE=false

# Allow creating new accounts from the login screen
ALLOW_SIGNUP=true

# ----------------------------------------------------------
# Google Drive (agreement document storage) — OAuth, not a service account.
# 1. Google Cloud Console -> APIs & Services -> Credentials
#    -> Create Credentials -> OAuth client ID -> Application type: Desktop app
# 2. Download the JSON, save it as credentials.json in the project root
#    (or set a custom path/name below).
# 3. Set GOOGLE_DRIVE_FOLDER_ID to the target Drive folder's id.
# 4. Run: python google_oauth_setup.py   (one-time browser sign-in)
# ----------------------------------------------------------
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=

